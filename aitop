def main():
    ap = argparse.ArgumentParser(prog='aitop', description=__doc__.split('\n')[0])
    ap.add_argument('--version', action='version', version=f'aitop {__version__}')
    sub = ap.add_subparsers(dest='cmd')
    p_list = sub.add_parser('list', help='table of sessions (default command)')
    p_list.add_argument('--all', action='store_true', help='include closed and archived sessions')
    p_list.add_argument('--since', type=parse_since,
                        help='activity window, e.g. 30m, 12h, 7d (default 7d; no window with --all)')
    p_list.add_argument('--runtime', help='prefix filter: vscode, claude-cli, claude-code, codex, codex-app ...')
    p_catch = sub.add_parser('catchup', help='sessions waiting on you, with the latest reply')
    sub.add_parser('week', help='sessions created or active since Monday 00:00')
    p_show = sub.add_parser('show', help='full latest reply of one session; marks it seen')
    p_show.add_argument('id', help='session id prefix')
    p_ack = sub.add_parser('ack', help='mark sessions seen so catchup stops listing them')
    p_ack.add_argument('ids', nargs='*', help='session id prefixes')
    p_ack.add_argument('--all', action='store_true', help='ack every session in the default view')
    for p in (p_catch, p_ack):
        p.add_argument('--since', type=parse_since, default=parse_since('7d'),
                       help='activity window, e.g. 30m, 12h, 7d (default 7d)')
    p_serve = sub.add_parser('serve', help='web portal on http://127.0.0.1:<port>/')
    p_serve.add_argument('--port', type=int, default=8765)
    p_brief = sub.add_parser('brief', help='work briefing for a day, week or month, as Markdown')
    p_brief.add_argument('kind', nargs='?', default='weekly', choices=BRIEF_KINDS)
    p_brief.add_argument('--date', type=parse_day, default=date.today(), help='any day inside the period (default today)')
    p_brief.add_argument('--regenerate', action='store_true', help='write it again even if one is cached')
    commands = {'list': cmd_list, 'catchup': cmd_catchup, 'week': cmd_week, 'show': cmd_show,
                'ack': cmd_ack, 'serve': cmd_serve, 'brief': cmd_brief}
    argv = sys.argv[1:]
    if not argv or argv[0] not in (*commands, '-h', '--help', '--version'):
        argv = ['list'] + argv
    args = ap.parse_args(argv)
    try:
        commands[args.cmd](args)
    except NotFound as e:
        sys.exit(f'aitop: {e}')


if __name__ == '__main__':
    main()
