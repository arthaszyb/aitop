  padding: 9px 14px; border-radius: 10px; background: var(--ink); color: var(--surface); font-size: 13px; font-weight: 560; box-shadow: var(--pop); }

@media (max-width: 1180px) {
  .kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .kpi:nth-child(4) { border-left: 0; }
  .kpi:nth-child(n+4) { border-top: 1px solid var(--line); }
  .tr { grid-template-columns: minmax(0, 2.4fr) 118px minmax(0, 1.5fr) 56px; }
  .tr > .cell-proj { display: none; }
}
@media (max-width: 900px) {
  .app { display: block; }
  .rail { position: sticky; z-index: 10; height: auto; flex-direction: row; align-items: center; gap: 12px; padding: 10px 16px;
    border-right: 0; border-bottom: 1px solid var(--line); overflow-x: auto; }
  .nav { flex-direction: row; }
  .nav button { width: auto; white-space: nowrap; }
  .nav button.active { box-shadow: inset 0 -2px 0 var(--ink); }
  .rail-sec, .rail-foot { display: none; }
  .main { padding: 20px 16px 64px; }
  .grid-2 { grid-template-columns: minmax(0, 1fr); }
  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .kpi:nth-child(odd) { border-left: 0; }
  .kpi:nth-child(4) { border-left: 1px solid var(--line); }
  .kpi:nth-child(n+3) { border-top: 1px solid var(--line); }
  .item { grid-template-columns: 30px minmax(0, 1fr); padding: 16px; }
  .item-actions { grid-column: 2; flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
  .tr { grid-template-columns: minmax(0, 1fr) auto; gap: 6px 12px; }
  .tr.head { display: none; }
  .tr > :nth-child(2) { grid-column: 2; grid-row: 1; }
  .tr > .cell-step { grid-column: 1 / -1; padding-left: 42px; }
  .tr > .cell-time { display: none; }
  .d-wrap { padding: 18px 16px 40px; }
}
</style>
</head>
<body>
<div class="app">
  <aside class="rail">
    <div class="brand"><span class="brand-mark" aria-hidden="true"><i style="background: var(--rt-vscode)"></i><i style="background: var(--rt-claude-code)"></i><i style="background: var(--rt-codex-app)"></i><i style="background: var(--rt-claude-cli)"></i></span>aitop</div>
    <nav class="nav" id="nav">
      <button data-view="inbox"><svg class="i" viewBox="0 0 16 16"><path d="M2 9.5 3.8 3.6A1.5 1.5 0 0 1 5.2 2.5h5.6a1.5 1.5 0 0 1 1.4 1.1L14 9.5V12a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12z"/><path d="M2 9.5h3.2l.8 1.5h4l.8-1.5H14"/></svg>Needs you<span class="count" id="nav-count"></span></button>
      <button data-view="week"><svg class="i" viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="11" rx="2"/><path d="M2 6.5h12M5.5 1.8v2.4M10.5 1.8v2.4"/></svg>This week</button>
      <button data-view="sessions"><svg class="i" viewBox="0 0 16 16"><path d="M5.5 4h8M5.5 8h8M5.5 12h8M2.5 4h.01M2.5 8h.01M2.5 12h.01"/></svg>All sessions</button>
      <button data-view="insights"><svg class="i" viewBox="0 0 16 16"><path d="M2.5 13.5h11M4.5 11V8M8 11V4.5M11.5 11V6.5"/></svg>Insights</button>
      <button data-view="briefs"><svg class="i" viewBox="0 0 16 16"><path d="M4 1.8h5.2L12.5 5v9a.7.7 0 0 1-.7.7H4a.7.7 0 0 1-.7-.7V2.5A.7.7 0 0 1 4 1.8z"/><path d="M9 1.8v3.5h3.5M5.6 8.3h4.8M5.6 11h3.2"/></svg>Briefings</button>
    </nav>
    <div class="rail-sec">
      <div class="rail-label">Active by runtime</div>
      <ul class="rt-list" id="rt-list"></ul>
    </div>
    <div class="rail-foot">
      <div class="live" id="live"><span class="live-dot"></span><span id="updated">Connecting</span></div>
      <label class="switch">Auto-refresh<input type="checkbox" id="auto" checked></label>
    </div>
  </aside>
  <main class="main">
    <header class="page-head">
      <div><h1 id="h-title">Needs you</h1><p id="h-sub">Loading sessions</p></div>
      <div class="head-actions"><button class="btn" id="refresh"><svg class="i" viewBox="0 0 16 16"><path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2.5v3h-3"/></svg>Refresh</button></div>
    </header>
    <div class="banner" id="error" hidden></div>
    <section class="view" id="view-inbox"></section>
    <section class="view" id="view-week" hidden></section>
    <section class="view" id="view-sessions" hidden>
      <div class="filters">
        <label class="search"><svg class="i" viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.5"/><path d="m13.5 13.5-3.2-3.2"/></svg><input class="field" id="f-q" type="search" placeholder="Search name, prompt, step, project or id"></label>
        <select class="field" id="f-rt" aria-label="Runtime"><option value="">All runtimes</option></select>
        <select class="field" id="f-since" aria-label="Activity window">
          <option value="1d">Active in the last day</option>
          <option value="3d">Active in the last 3 days</option>
          <option value="7d" selected>Active in the last 7 days</option>
          <option value="30d">Active in the last 30 days</option>
          <option value="">Any time</option>
        </select>
        <label class="check"><input type="checkbox" id="f-incl">Include closed and archived</label>
      </div>
      <div class="chips" id="f-chips"></div>
      <div id="s-list"></div>
    </section>
    <section class="view" id="view-insights" hidden></section>
    <section class="view" id="view-briefs" hidden></section>
  </main>
</div>
<div class="scrim" id="scrim" hidden></div>
<aside class="drawer" id="drawer" hidden aria-label="Session details"></aside>
<div class="tip" id="tip" hidden></div>
<script>
const $ = s => document.querySelector(s);
const SVGNS = 'http://www.w3.org/2000/svg';
const VIEWS = ['inbox', 'week', 'sessions', 'insights', 'briefs'];
const STATUSES = ['waiting', 'running', 'your-turn', 'closed', 'archived'];
const STATUS_LABEL = {waiting: 'Waiting', running: 'Running', 'your-turn': 'Your turn', closed: 'Closed', archived: 'Archived'};
const RT_ORDER = ['vscode', 'claude-code', 'codex-app', 'claude-cli', 'codex-cli', 'codex-chrome', 'codex', 'claude-archive', 'other'];
// [label, icon, app that owns the session view]; null app means it is resumed in a terminal.
const RT = {
  'vscode': ['Claude in VSCode', 'code', 'VSCode'],
  'claude-code': ['Claude Desktop', 'spark', 'Claude'],
  'codex-app': ['Codex app', 'hex', 'Codex'],
  'claude-cli': ['Claude CLI', 'prompt', null],
  'codex-cli': ['Codex CLI', 'hexprompt', null],
  'codex-chrome': ['Codex in Chrome', 'globe', 'Codex'],
  'codex': ['Codex, other clients', 'cube', 'Codex'],
  'claude-archive': ['Claude, earlier history', 'clock', null],
  'other': ['Other', 'dot', null],
};
const ICONS = {
  code: '<path d="M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5"/>',
  spark: '<path d="M8 2v12M2 8h12M3.8 3.8l8.4 8.4M12.2 3.8l-8.4 8.4"/>',
  hex: '<path d="M8 1.8l5.4 3.1v6.2L8 14.2l-5.4-3.1V4.9z"/><circle cx="8" cy="8" r="1.7"/>',
  prompt: '<rect x="1.8" y="2.8" width="12.4" height="10.4" rx="2"/><path d="m4.6 6.3 2 1.7-2 1.7M8.4 10h3"/>',
  hexprompt: '<path d="M8 1.8l5.4 3.1v6.2L8 14.2l-5.4-3.1V4.9z"/><path d="m6.6 6.3 1.9 1.7-1.9 1.7"/>',
  globe: '<circle cx="8" cy="8" r="6"/><path d="M2 8h12M8 2c1.7 1.7 2.5 3.8 2.5 6S9.7 12.3 8 14C6.3 12.3 5.5 10.2 5.5 8S6.3 3.7 8 2z"/>',
  cube: '<path d="M8 1.8l5.5 3.2v6L8 14.2 2.5 11V5z"/><path d="M2.5 5 8 8.2 13.5 5M8 8.2v6"/>',
  clock: '<circle cx="8" cy="8" r="6"/><path d="M8 4.8V8l2.2 1.4"/>',
  dot: '<circle cx="8" cy="8" r="3"/>',
  external: '<path d="M9.5 2.5h4v4M13.5 2.5 7.5 8.5M12 9.5v3a1 1 0 0 1-1 1H3.5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3"/>',
  copy: '<rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/><path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"/>',
  check: '<path d="m3 8.5 3 3 7-7"/>',
  close: '<path d="m4 4 8 8M12 4l-8 8"/>',
  waiting: '<circle cx="8" cy="8" r="6"/><path d="M8 5v3.5M8 11h.01"/>',
  running: '<path d="M8 2a6 6 0 1 1-6 6"/>',
  'your-turn': '<path d="M2.5 4.5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H7.2L4.5 13.5v-2a2 2 0 0 1-2-2z"/>',
  closed: '<circle cx="8" cy="8" r="6"/><path d="M5.5 8h5"/>',
  archived: '<rect x="2" y="3" width="12" height="3" rx="1"/><path d="M3 6v6.5a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V6M6.5 9h3"/>',
  left: '<path d="m10 3.5-4.5 4.5 4.5 4.5"/>',
  right: '<path d="m6 3.5 4.5 4.5-4.5 4.5"/>',
  refresh: '<path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2.5v3h-3"/>',
  write: '<path d="M10.8 2.7a1.6 1.6 0 0 1 2.3 2.3L6 12.2l-3 .8.8-3z"/>',
};
const RANGE_NAME = {'7d': '7 days', '30d': '30 days', '90d': '90 days', all: 'all time'};
const state = {view: 'inbox', range: '30d', metric: 'all', rt: '', terminal: 'Ghostty', rows: [], stats: null,
               briefKind: 'weekly', briefDate: new Date().toLocaleDateString('en-CA'),
               statusOn: new Set(STATUSES)};
let loading = false, again = false;

function h(tag, attrs, ...kids) {
  const el = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs || {})) {
    if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
    else if (k === 'class') el.className = v;
    else el.setAttribute(k, v);
  }
  for (const kid of kids.flat(Infinity)) if (kid != null && kid !== false && kid !== '') el.append(kid);
  return el;
}
function sv(tag, attrs, text) {
  const el = document.createElementNS(SVGNS, tag);
  for (const [k, v] of Object.entries(attrs || {})) el.setAttribute(k, v);
  if (text != null) el.textContent = text;
  return el;
}
function icon(name, cls) {
  const el = sv('svg', {viewBox: '0 0 16 16', class: 'i' + (cls ? ' ' + cls : ''), 'aria-hidden': 'true'});
  el.innerHTML = ICONS[name] || ICONS.dot;  // static markup from ICONS, never session data
  return el;
}

const rtKey = runtime => { const k = (runtime || '').split('/')[0]; return RT[k] ? k : 'other'; };
const rtProvider = runtime => (runtime || '').split('/')[1] || '';
const rtLabel = runtime => RT[rtKey(runtime)][0] + (rtProvider(runtime) ? `, ${rtProvider(runtime)}` : '');
const compact = v => new Intl.NumberFormat('en', {notation: 'compact', maximumFractionDigits: 1}).format(v);
const fmtBytes = b => b >= 2 ** 30 ? `${(b / 2 ** 30).toFixed(1)} GB` : b >= 2 ** 20 ? `${Math.round(b / 2 ** 20)} MB`
  : `${Math.max(1, Math.round(b / 2 ** 10))} KB`;
const when = ms => new Date(ms).toLocaleString(undefined, {month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'});
const fmtDay = iso => new Date(iso + 'T00:00').toLocaleDateString(undefined, {month: 'short', day: 'numeric'});
const project = cwd => (cwd || '').split('/').filter(Boolean).pop() || '';
const pad = n => String(n).padStart(2, '0');
function ago(ms) {
  const s = Math.max(0, Math.floor((Date.now() - ms) / 1000));
  for (const [u, n] of [['d', 86400], ['h', 3600], ['m', 60]]) if (s >= n) return Math.floor(s / n) + u;
  return s + 's';
}

function fail(e) {
  $('#error').textContent = e.message;
  $('#error').hidden = false;
}
async function api(path, body) {
  const init = body === undefined ? {} :
    {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)};
  const res = await fetch(path, init);
  const text = await res.text();
  if (!res.ok) {
    let msg = text;
    try { msg = JSON.parse(text).error; } catch (_) { /* not JSON: show the raw body */ }
    throw new Error(`${path} returned HTTP ${res.status}\n${msg}`);
  }
  return JSON.parse(text);
}
function toast(msg) {
  const t = h('div', {class: 'toast', role: 'status'}, icon('check'), msg);
  document.body.append(t);
  setTimeout(() => t.remove(), 2200);
}
async function copy(text) {
  await navigator.clipboard.writeText(text);
  toast('Copied resume command');
}
async function ack(ids) {
  if (!ids && !confirm('Mark every new reply as read?')) return;
  const r = await api('/api/ack', ids ? {ids} : {all: true});
  toast(r.acked === 1 ? 'Marked as read' : `Marked ${r.acked} sessions as read`);
  load();
}

// Jumping to a session: VSCode, Claude Desktop and Codex own their session views; CLI sessions resume in a terminal.
function appFor(r) {
  const k = rtKey(r.runtime);
  if (k === 'claude-cli' && r.live) return null;
  return RT[k][2] || state.terminal;
}
function openVerb(r) {
  const app = appFor(r);
  if (!app) return 'Focus its terminal';
  return ['VSCode', 'Claude', 'Codex'].includes(app) ? `Open in ${app}` : `Resume in ${app}`;
}
async function openSession(r, target) {
  const res = await api('/api/open', {id: r.id, target: target || 'app'});
  toast(`Opened in ${res.app}`);
}

function tile(runtime, small) {
  const k = rtKey(runtime);
  return h('span', {class: `tile rt-${k}${small ? ' sm' : ''}`, title: rtLabel(runtime)}, icon(RT[k][1]));
}
function statusPill(r, withAge) {
  const age = withAge ? ` ${ago(r.status === 'waiting' ? r.since : r.last_active)}` : '';
  return h('span', {class: 's-pill s-' + r.status}, icon(r.status), STATUS_LABEL[r.status] + age);
}
function titleLink(r) {
  return h('button', {class: 'title-link', title: openVerb(r), onclick: e => { e.stopPropagation(); openSession(r).catch(fail); }},
    h('span', {}, r.name), icon('external'));
}
function setHead(title, sub) {
  $('#h-title').textContent = title;
  $('#h-sub').textContent = sub;
}
function secHead(title, n, note, action) {
  return h('div', {class: 'sec-head'}, h('h2', {}, title), n != null && h('span', {class: 'n'}, String(n)),
    note && h('span', {class: 'note'}, note), action);
}

// ---- needs you
function inboxItem(r) {
  return h('article', {class: 'item'},
    tile(r.runtime),
    h('div', {class: 'item-body'},
      h('div', {class: 'item-title'}, titleLink(r), statusPill(r, true)),
      h('div', {class: 'meta'}, h('span', {}, rtLabel(r.runtime)), h('span', {title: r.cwd}, r.where),
        h('span', {class: 'mono'}, r.id.slice(0, 8))),
      r.detail && h('div', {class: 'callout'}, h('strong', {}, 'Needs you: '), r.detail),
      h('div', {class: 'preview'}, r.reply || 'No reply text yet.')),
    h('div', {class: 'item-actions'},
      h('button', {class: 'btn primary', onclick: () => openSession(r).catch(fail)}, icon('external'), openVerb(r)),
      r.status === 'your-turn' && h('button', {class: 'btn', onclick: () => ack([r.id]).catch(fail)}, icon('check'), 'Mark as read'),
      h('button', {class: 'btn ghost', onclick: () => openDetail(r.id).catch(fail)}, 'Full reply')));
}
function renderInbox(c) {
  const w = c.waiting.length, f = c.fresh.length;
  setHead('Needs you', w || f ? `${w} waiting on a decision, ${f} new ${f === 1 ? 'reply' : 'replies'} in the last 7 days`
    : 'Nothing is waiting on you');
  $('#view-inbox').replaceChildren(
    secHead('Waiting on a decision', w),
    w ? h('div', {class: 'inbox'}, c.waiting.map(inboxItem))
      : h('div', {class: 'empty'}, 'No agent is blocked on you. Permission prompts and questions show up here first.'),
    secHead('New replies', f, null,
      f > 0 && h('button', {class: 'btn', onclick: () => ack(null).catch(fail)}, icon('check'), 'Mark all as read')),
    f ? h('div', {class: 'inbox'}, c.fresh.map(inboxItem))
      : h('div', {class: 'empty'}, h('strong', {}, 'You are all caught up'), 'Finished turns from any agent appear here until you mark them as read.'));
}

// ---- session tables
function sessionRow(r) {
  const open = () => openDetail(r.id).catch(fail);
  return h('div', {class: 'tr', tabindex: '0', onclick: open, onkeydown: e => { if (e.key === 'Enter' && e.target === e.currentTarget) open(); }},
    h('div', {class: 'cell-session'}, tile(r.runtime), h('div', {}, titleLink(r), h('div', {class: 'sub'}, r.brief || 'No prompt yet'))),
    h('div', {}, statusPill(r)),
    h('div', {class: 'cell-step' + (r.error ? ' err' : ''), title: r.step}, r.step || '—'),
    h('div', {class: 'cell-proj', title: r.cwd}, h('div', {}, project(r.cwd)), h('div', {class: 'sub'}, rtLabel(r.runtime))),
    h('div', {class: 'cell-time', title: 'Last active ' + when(r.last_active)}, ago(r.last_active)));
}
function table(rows, empty) {
  if (!rows.length) return h('div', {class: 'empty'}, empty);
  return h('div', {class: 'table'},
    h('div', {class: 'tr head'}, h('div', {}, 'Session'), h('div', {}, 'Status'), h('div', {}, 'Latest step'),
      h('div', {class: 'cell-proj'}, 'Project'), h('div', {class: 'cell-time'}, 'Active')),
    rows.map(sessionRow));
}
function renderWeek(w) {
  const start = new Date(w.start).toLocaleDateString(undefined, {weekday: 'long', month: 'short', day: 'numeric'});
  setHead('This week', `${w.new.length} sessions started since ${start}, ${w.resumed.length} older ones picked up again`);
  $('#view-week').replaceChildren(
    secHead('Started this week', w.new.length),
    table(w.new, 'No session has started this week.'),
    secHead('Picked up again', w.resumed.length, 'Created before this week and active since Monday'),
    table(w.resumed, 'No older session was active this week.'));
}
function renderSessions(d) {
  state.rows = d.rows;
  const keys = RT_ORDER.filter(k => d.rows.some(r => rtKey(r.runtime) === k));
  $('#f-rt').replaceChildren(h('option', {value: ''}, 'All runtimes'), ...keys.map(k => h('option', {value: k}, RT[k][0])));
  $('#f-rt').value = keys.includes(state.rt) ? state.rt : '';
  drawSessions();
}
function drawSessions() {
  state.rt = $('#f-rt').value;
  const q = $('#f-q').value.trim().toLowerCase();
  const base = state.rows.filter(r => (!state.rt || rtKey(r.runtime) === state.rt) &&
    (!q || [r.name, r.brief, r.step, r.cwd, r.id].join('\n').toLowerCase().includes(q)));
  const counts = Object.fromEntries(STATUSES.map(s => [s, base.filter(r => r.status === s).length]));
  $('#f-chips').replaceChildren(...STATUSES.filter(s => counts[s]).map(s => h('button', {
    class: `s-pill s-${s} chip${state.statusOn.has(s) ? '' : ' off'}`, 'aria-pressed': String(state.statusOn.has(s)),
    onclick: () => { state.statusOn.has(s) ? state.statusOn.delete(s) : state.statusOn.add(s); drawSessions(); }},
    icon(s), `${STATUS_LABEL[s]} ${counts[s]}`)));
  const rows = base.filter(r => state.statusOn.has(r.status));
  $('#s-list').replaceChildren(table(rows, 'No sessions match these filters.'));
  setHead('All sessions', `${rows.length} of ${state.rows.length} sessions shown`);
  document.querySelectorAll('.rt-item').forEach(b => b.classList.toggle('on', b.dataset.rt === state.rt));
}

// ---- rail
function renderRail(c) {
  const need = c.waiting.length + c.fresh.length;
  $('#nav-count').textContent = need || '';
  document.title = need ? `(${need}) aitop` : 'aitop';
  state.terminal = c.terminal;
  const keys = RT_ORDER.filter(k => c.runtimes[k]);
  $('#rt-list').replaceChildren(...keys.length ? keys.map(k => {
    const n = c.runtimes[k];
    return h('li', {}, h('button', {class: 'rt-item' + (state.view === 'sessions' && state.rt === k ? ' on' : ''), 'data-rt': k,
      title: `${n.waiting} waiting, ${n.running} running, ${n['your-turn']} your turn`,
      onclick: () => { state.rt = k; $('#f-rt').value = k; go('sessions'); }},
      tile(k, true), h('span', {class: 'rt-name'}, RT[k][0]),
      n.waiting > 0 && h('span', {class: 'rt-wait'}, String(n.waiting)),
      h('span', {class: 'rt-n'}, String(n.waiting + n.running + n['your-turn']))));
  }) : [h('li', {class: 'rail-label'}, 'No active sessions')]);
}

// ---- drawer
async function openDetail(id) {
  const d = await api('/api/session?id=' + encodeURIComponent(id));
  const kv = (k, v) => [h('dt', {}, k), h('dd', {}, v)];
  const app = appFor(d);
  $('#drawer').replaceChildren(h('div', {class: 'd-wrap'},
    h('div', {class: 'd-head'}, tile(d.runtime),
      h('div', {class: 'd-title'}, h('h2', {}, d.name), h('div', {class: 'd-sub'}, statusPill(d, true), h('span', {}, rtLabel(d.runtime)))),
      h('button', {class: 'btn ghost icon-only', 'aria-label': 'Close', onclick: closeDetail}, icon('close'))),
    h('div', {class: 'd-actions'},
      h('button', {class: 'btn primary', onclick: () => openSession(d).catch(fail)}, icon('external'), openVerb(d)),
      ['VSCode', 'Claude', 'Codex'].includes(app) &&
        h('button', {class: 'btn', onclick: () => openSession(d, 'terminal').catch(fail)}, icon('prompt'), `Resume in ${state.terminal}`),
      d.status === 'your-turn' && h('button', {class: 'btn', onclick: () => ack([d.id]).then(closeDetail).catch(fail)}, icon('check'), 'Mark as read')),
    d.detail && h('div', {class: 'callout'}, h('strong', {}, 'Needs you: '), d.detail),
