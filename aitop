// ---- loading and navigation
async function load(quiet) {
  if (loading) { again = true; return; }
  loading = true;
  const view = $('#view-' + state.view);
  if (state.view === 'insights' && !state.stats)
    view.replaceChildren(h('div', {class: 'empty'}, h('strong', {}, 'Indexing session history'),
      'The first run reads every transcript once and can take about 15 seconds. Later visits only read what changed.'));
  if (!quiet) view.classList.add('busy');
  try {
    const c = await api('/api/catchup?since=7d');
    renderRail(c);
    if (state.view === 'inbox') renderInbox(c);
    else if (state.view === 'week') renderWeek(await api('/api/week'));
    else if (state.view === 'sessions')
      renderSessions(await api(`/api/list?all=${$('#f-incl').checked ? 1 : 0}&since=${encodeURIComponent($('#f-since').value)}`));
    else if (state.view === 'briefs') renderBriefs(await api(`/api/brief?kind=${state.briefKind}&date=${state.briefDate}`));
    else renderInsights(await api('/api/stats?range=' + state.range));
    $('#error').hidden = true;
    $('#updated').textContent = 'Updated ' + new Date().toLocaleTimeString(undefined, {hour: '2-digit', minute: '2-digit', second: '2-digit'});
  } catch (e) {
    fail(e);
  } finally {
    view.classList.remove('busy');
    loading = false;
    if (again) { again = false; load(); }
  }
}
function go(v) {
  state.view = v;
  history.replaceState(null, '', '#' + v);
  document.querySelectorAll('#nav button').forEach(b => b.classList.toggle('active', b.dataset.view === v));
  VIEWS.forEach(x => { $('#view-' + x).hidden = x !== v; });
  closeDetail();
