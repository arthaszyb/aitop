.check { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); cursor: pointer; user-select: none; font-size: 13px; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }

/* runtime tiles and status pills */
.tile { --c: var(--rt-other); display: inline-grid; place-items: center; flex: none; width: 30px; height: 30px; border-radius: 8px;
  color: var(--c); background: color-mix(in srgb, var(--c) 13%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 28%, transparent); }
