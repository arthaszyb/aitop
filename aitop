HOME = os.path.expanduser('~')
CLAUDE_DIR = os.environ.get('CLAUDE_CONFIG_DIR') or os.path.join(HOME, '.claude')
DESKTOP_DIR = (os.environ.get('AITOP_CLAUDE_DESKTOP_DIR')
               or os.path.join(HOME, 'Library/Application Support/Claude/claude-code-sessions'))
CODEX_DIR = os.environ.get('CODEX_HOME') or os.path.join(HOME, '.codex')
CONFIG_PATH = os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.join(HOME, '.config'), 'aitop', 'config.json')
STATE_DIR = os.path.join(os.environ.get('XDG_STATE_HOME') or os.path.join(HOME, '.local', 'state'), 'aitop')
CACHE_DIR = os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.join(HOME, '.cache'), 'aitop')
SEEN_PATH = os.path.join(STATE_DIR, 'seen.json')
OPENER = 'open' if sys.platform == 'darwin' else 'xdg-open'

STATUS_ORDER = {'waiting': 0, 'running': 1, 'your-turn': 2, 'closed': 3, 'archived': 4}
STATUS_COLOR = {'waiting': '1;31', 'running': '33', 'your-turn': '32', 'closed': '2', 'archived': '2'}
CLAUDE_RUNTIME = {'claude-vscode': 'vscode', 'cli': 'claude-cli', 'claude-desktop': 'claude-code'}
CLAUDE_REG_STATUS = {'busy': 'running', 'waiting': 'waiting', 'idle': 'your-turn'}
# A Codex turn with no completion event and no rollout write for this long is treated as dead.
CODEX_STALE_MS = 10 * 60 * 1000
# Wrappers the IDE / harness injects into user turns; they are not what the user asked.
NOISE_TAGS = re.compile(
    r'<(ide_[a-z_]+|system-reminder|command-[a-z-]+|local-command-[a-z-]+|environment_context)\b[^>]*>.*?</\1>',
    re.S)


def now_ms():
    return int(time.time() * 1000)


def iso_ms(ts):
    # Python before 3.11 rejects the trailing Z that both agents write.
    return int(datetime.fromisoformat(ts[:-1] + '+00:00' if ts.endswith('Z') else ts).timestamp() * 1000)


WARNED = set()


def warn(msg):
    """Report a skipped or unreadable file once per process on stderr."""
    if msg not in WARNED:
        WARNED.add(msg)
        print(f'aitop: {msg}', file=sys.stderr, flush=True)


def describe(error):
    return f'{type(error).__name__}: {error}'[:300]


def one_line(text):
    return ' '.join(text.split())


def first_line(text):
    for line in text.splitlines():
        if line.strip():
            return line.strip()
    return ''


def parse_since(value):
    m = re.fullmatch(r'(\d+)([mhd])', value)
    if not m:
        raise argparse.ArgumentTypeError(f'expected e.g. 30m, 12h, 7d; got {value!r}')
    return int(m.group(1)) * {'m': 60, 'h': 3600, 'd': 86400}[m.group(2)] * 1000


def read_tail(path, nbytes):
    """Parse the JSONL records in the last nbytes of path."""
    size = os.path.getsize(path)
    with open(path, 'rb') as f:
        f.seek(max(0, size - nbytes))
        lines = f.read().split(b'\n')
    if size > nbytes:
        lines = lines[1:]  # cut mid-record by the seek
    records = []
    for i, line in enumerate(lines):
        if not line.strip():
            continue
        try:
            records.append(json.loads(line))
        except json.JSONDecodeError as e:
            if i == len(lines) - 1:
                continue  # the agent is still writing this record
            raise ValueError(f'{path}: unparseable JSONL record: {e}') from e
    return records


def read_tail_until(path, has_enough, start=512 * 1024, limit=8 * 1024 * 1024):
    size = os.path.getsize(path)
    n = start
    while True:
        records = read_tail(path, n)
        if has_enough(records) or n >= size or n >= limit:
            return records
        n *= 2


# ---------------------------------------------------------------- Claude

def claude_text(content):
    if isinstance(content, str):
        return content
    return '\n'.join(b.get('text', '') for b in content if b.get('type') == 'text')


def claude_prompt(rec):
    """The human prompt in a user record, or '' for tool results, meta and injected records."""
    if rec.get('type') != 'user' or rec.get('isMeta') or rec.get('isSidechain'):
        return ''
    content = rec['message'].get('content')
    if isinstance(content, list) and any(b.get('type') == 'tool_result' for b in content):
        return ''
    text = NOISE_TAGS.sub('', claude_text(content or ''))
    text = re.sub(r'</?pasted_content[^>]*>', '', text).strip()
    if text.startswith('Caveat:') or text.startswith('[Request interrupted'):
        return ''
    return text


def claude_step(rec):
    for block in reversed(rec['message'].get('content') or []):
        if block.get('type') == 'tool_use':
            inp = block.get('input') or {}
            arg = next((inp[k] for k in ('description', 'command', 'file_path', 'pattern', 'query',
                                         'url', 'skill', 'prompt')
                        if isinstance(inp.get(k), str) and inp[k].strip()), '')
            return f"{block['name']}: {first_line(arg)}" if arg else block['name']
        if block.get('type') == 'text' and block['text'].strip():
            return first_line(block['text'])
    return ''


def claude_head(path):
    """First human prompt plus entrypoint/cwd/creation time, reading at most 2MB from the start."""
    info = {'brief': '', 'entrypoint': None, 'cwd': None, 'created': None}
    read = 0
    with open(path, 'rb') as f:
        for raw in f:
            read += len(raw)
            if read > 2 * 1024 * 1024:
                break
            try:
                rec = json.loads(raw)
            except json.JSONDecodeError:
                break  # only possible on the last line of a file still being written
            info['entrypoint'] = info['entrypoint'] or rec.get('entrypoint')
            info['cwd'] = info['cwd'] or rec.get('cwd')
            if info['created'] is None and rec.get('timestamp'):
                info['created'] = iso_ms(rec['timestamp'])
            prompt = claude_prompt(rec)
            if prompt:
                info['brief'] = prompt
                break
    return info


def claude_tail(path):
    records = read_tail_until(path, lambda rs: any(r.get('type') == 'assistant' for r in rs))
    info = {'titles': {}, 'last_active': 0, 'step': '', 'reply': '', 'last_prompt': ''}
    for rec in records:
        t = rec.get('type')
        if t == 'custom-title':
            info['titles']['custom'] = rec['customTitle']
        elif t == 'agent-name':
            info['titles']['agent'] = rec['agentName']
        elif t == 'ai-title':
            info['titles']['ai'] = rec['aiTitle']
        elif t == 'last-prompt' and rec.get('lastPrompt'):  # some carry only leafUuid
            info['last_prompt'] = rec['lastPrompt']
        elif t in ('user', 'assistant') and not rec.get('isSidechain'):
            info['last_active'] = max(info['last_active'], iso_ms(rec['timestamp']))
            if t == 'assistant':
                info['step'] = claude_step(rec) or info['step']
                text = claude_text(rec['message'].get('content') or [])
                if text.strip():
                    info['reply'] = text.strip()
            elif not info['last_prompt'] and claude_prompt(rec):
                info['last_prompt'] = claude_prompt(rec)
    return info


def load_registry():
    live = {}
    for path in glob.glob(os.path.join(CLAUDE_DIR, 'sessions', '*.json')):
        try:
            with open(path) as f:
                entry = json.load(f)
        except FileNotFoundError:
            continue  # process exited between glob and open
        except ValueError as e:
            warn(f'skipped live-session file {path}: {describe(e)}')
            continue
        try:
            os.kill(entry['pid'], 0)
        except (ProcessLookupError, PermissionError):
            continue  # gone, or the pid now belongs to another user's process
        sid = entry['sessionId']
        if sid not in live or entry['updatedAt'] > live[sid]['updatedAt']:
            live[sid] = entry
    return live


def load_desktop():
    meta = {}
    for path in glob.glob(os.path.join(DESKTOP_DIR, '*', '*', 'local_*.json')):
        try:
            with open(path) as f:
                d = json.load(f)
            meta[d.get('cliSessionId') or d['sessionId']] = d
        except (ValueError, KeyError) as e:
            warn(f'skipped Claude Desktop file {path}: {describe(e)}')
    return meta


def unreadable_row(kind, sid, path, error, name=None, cwd='', runtime=None):
    """A session whose files could not be parsed: listed with the error instead of failing every command."""
    warn(f'could not read {kind} session {sid}: {describe(error)}')
    mtime = int(os.path.getmtime(path) * 1000) if path and os.path.exists(path) else 0
    return {
        'key': f'{kind}:{sid}', 'id': sid, 'status': 'closed', 'detail': '', 'since': mtime, 'live': False,
        'runtime': runtime or kind, 'name': name or sid[:8], 'brief': '',
        'step': f'Could not read this session: {describe(error)}', 'last_active': mtime, 'created': mtime,
        'cwd': cwd or '', 'focused': 0, 'reply': '', 'last_prompt': '', 'provider': None, 'pid': None,
        'desktop_id': None, 'path': path, 'error': describe(error),
    }


def load_claude(cutoff, include_all, id_prefix):
    registry = load_registry()
    desktop = load_desktop()
    transcripts = {}
    for path in glob.glob(os.path.join(CLAUDE_DIR, 'projects', '*', '*.jsonl')):
        sid = os.path.basename(path)[:-len('.jsonl')]
        if sid not in transcripts or os.path.getmtime(path) > os.path.getmtime(transcripts[sid]):
            transcripts[sid] = path

    rows = []
    for sid in set(transcripts) | set(desktop) | set(registry):
        if id_prefix and not sid.startswith(id_prefix):
            continue
        reg, dm, path = registry.get(sid), desktop.get(sid), transcripts.get(sid)
        if not id_prefix and not reg:
            # Without a live process only Desktop sessions can be anything but closed/archived.
            if not include_all and (not dm or dm.get('isArchived')):
                continue
            # Activity is appended to the transcript, so an mtime before the cutoff rules it out unread.
            newest = max((dm or {}).get('lastActivityAt') or 0, int(os.path.getmtime(path) * 1000) if path else 0)
            if cutoff is not None and newest < cutoff:
                continue
        try:
            rows.append(claude_row(sid, reg, dm, path))
        except Exception as e:
            rows.append(unreadable_row('claude', sid, path, e, name=(dm or {}).get('title') or (reg or {}).get('name'),
                                       cwd=(reg or dm or {}).get('cwd', '')))
    return rows


def claude_row(sid, reg, dm, path):
    head = claude_head(path) if path else {'brief': '', 'entrypoint': None, 'cwd': None, 'created': None}
    tail = claude_tail(path) if path else {'titles': {}, 'last_active': 0, 'step': '', 'reply': '', 'last_prompt': ''}
    pts = (dm or {}).get('postTurnSummary') or {}
    detail, since = '', None
    if dm and dm.get('isArchived'):
        status = 'archived'
    elif reg:
        status = CLAUDE_REG_STATUS.get(reg.get('status'))
        if status is None:
            raise ValueError(f"pid {reg['pid']}: unknown Claude session status {reg.get('status')!r}")
        detail = reg.get('waitingFor') or ''
        since = reg.get('statusUpdatedAt')
    elif dm:
        status = 'waiting' if pts.get('status_category') == 'blocked' else 'your-turn'
        detail = pts.get('needs_action') or ''
    else:
        status = 'closed'

    # A Desktop session resumed in VSCode runs in VSCode now, so the live process decides.
    entrypoint = (reg or {}).get('entrypoint') or head['entrypoint'] or ('claude-desktop' if dm else None)
    titles = tail['titles']
    reg_name = (reg or {}).get('name')
    name = (titles.get('custom')
            or (reg_name if reg and reg.get('nameSource') != 'derived' else None)
            or (dm or {}).get('title') or titles.get('agent') or titles.get('ai') or reg_name or sid[:8])
    step = tail['step']
    if dm and not reg and pts.get('status_detail') and dm.get('postTurnSummaryFor') == dm.get('lastAssistantUuid'):
        step = pts['status_detail']
    last_active = (tail['last_active'] or (dm or {}).get('lastActivityAt')
                   or (reg or {}).get('updatedAt') or int(os.path.getmtime(path) * 1000))
    return {
        'key': f'claude:{sid}', 'id': sid, 'status': status, 'detail': detail,
        'since': since or last_active, 'live': bool(reg),
        'runtime': CLAUDE_RUNTIME.get(entrypoint, entrypoint or 'claude'),
        'name': name, 'brief': head['brief'], 'step': step, 'last_active': last_active,
        'created': head['created'] or (dm or {}).get('createdAt') or (reg or {}).get('startedAt') or last_active,
        'cwd': head['cwd'] or (reg or {}).get('cwd') or (dm or {}).get('cwd') or '',
        'focused': (dm or {}).get('lastFocusedAt') or 0,
        'reply': tail['reply'] or pts.get('status_detail') or '', 'last_prompt': tail['last_prompt'],
        'provider': None, 'pid': (reg or {}).get('pid'), 'desktop_id': (dm or {}).get('sessionId'), 'path': path,
        'error': None,
    }


# ---------------------------------------------------------------- Codex

def codex_request(text):
    """Codex desktop prefixes prompts with attached-file headers; keep only the request."""
    parts = re.split(r'^## My request[^:\n]*:', text, maxsplit=1, flags=re.M)
    return parts[-1].strip()


def codex_runtime(source, originator, provider):
    if originator in ('Codex Desktop', 'codex_work_desktop'):
        rt = 'codex-app'
    elif originator == 'codex-chrome-extension-sidepanel':
        rt = 'codex-chrome'
    elif source == 'cli':
        rt = 'codex-cli'
    else:
        rt = 'codex'
    return f'{rt}/{codex_provider_label(provider)}'


def codex_step(payload):
    name = payload.get('name') or payload['type']
    if payload['type'] == 'function_call':
        args = json.loads(payload.get('arguments') or '{}')
        detail = ''
        if isinstance(args, dict):
            for k in ('title', 'description', 'cmd', 'command', 'path', 'query', 'url'):
                v = args.get(k)
                if isinstance(v, list):
                    v = ' '.join(map(str, v))
                if isinstance(v, str) and v.strip():
                    detail = v
                    break
    else:  # custom_tool_call: free-form input, usually JS around tools.exec_command({cmd:"..."})
        inp = payload.get('input') or ''
        m = re.search(r'cmd:\s*"((?:[^"\\]|\\.)*)"', inp)
        detail = m.group(1) if m else inp
    return f'{name}: {first_line(detail)}' if detail.strip() else name


def codex_tail(path):
    info = {'running': False, 'step': '', 'reply': '', 'last_prompt': ''}
    if not os.path.exists(path):
        info['step'] = '(rollout file missing)'
        return info
    records = read_tail_until(path, lambda rs: any(r.get('type') in ('response_item', 'event_msg') for r in rs),
                              start=256 * 1024)
    for rec in records:
        p = rec.get('payload') or {}
        t = p.get('type')
        if rec.get('type') == 'event_msg':
            if t == 'task_started':
                info['running'] = True
            elif t == 'task_complete':
                info['running'] = False
                if p.get('last_agent_message'):
                    info['reply'] = p['last_agent_message']
            elif t == 'turn_aborted':
                info['running'] = False
                info['step'] = 'turn aborted'
        elif rec.get('type') == 'response_item':
            if t in ('function_call', 'custom_tool_call'):
                info['step'] = codex_step(p)
            elif t == 'message' and p.get('role') in ('assistant', 'user'):
                text = '\n'.join(c.get('text', '') for c in p.get('content') or [] if 'text' in c).strip()
                if p['role'] == 'assistant' and text:
                    info['step'] = first_line(text)
                    info['reply'] = text
                elif p['role'] == 'user' and text and not text.startswith('<'):
                    info['last_prompt'] = codex_request(text)
    return info


def codex_db():
    dbs = sorted(glob.glob(os.path.join(CODEX_DIR, 'state_*.sqlite')),
                 key=lambda p: int(re.search(r'state_(\d+)', p).group(1)))
    return dbs[-1] if dbs else None


@cache
def codex_config():
    """The two Codex settings aitop needs: the default provider and provider display names.

    Read line by line instead of with tomllib so aitop runs on Python 3.9, which ships without it.
    """
    cfg = {'model_provider': 'openai', 'names': {}}  # openai is Codex's own default provider
    path = os.path.join(CODEX_DIR, 'config.toml')
    if not os.path.exists(path):
        return cfg
    table = ''
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line.startswith('['):
                table = line.strip('[] ')
                continue
            m = re.match(r'([A-Za-z0-9_-]+)\s*=\s*(["\'])(.*?)\2', line)
            if not m:
                continue
            if table == '' and m.group(1) == 'model_provider':
                cfg['model_provider'] = m.group(3)
            elif table.startswith('model_providers.') and m.group(1) == 'name':
                cfg['names'][table.split('.', 1)[1].strip('"\'')] = m.group(3)
    return cfg


def codex_default_provider():
    return codex_config()['model_provider']


def codex_provider_label(provider):
    """Display name for a model provider id, taken from the user's own Codex config."""
    if provider == 'openai':
        return 'built-in'
    return codex_config()['names'].get(provider) or provider


def load_codex(cutoff, include_all, id_prefix):
    db = codex_db()
    if not db:
        return []
    con = sqlite3.connect(f'file:{db}?mode=ro', uri=True)
    sql = """select id, rollout_path, coalesce(updated_at_ms, updated_at * 1000),
                    coalesce(created_at_ms, created_at * 1000), source, coalesce(originator, ''),
                    model_provider, cwd, coalesce(nullif(name, ''), title), first_user_message, archived
             from threads
             where coalesce(thread_source, '') != 'guardian_review' and source not like '{"subagent"%'"""
    params = []
    if id_prefix:
        sql += ' and id like ?'
        params.append(id_prefix + '%')
    else:
        if not include_all:
            sql += ' and archived = 0'
        if cutoff is not None:
            sql += ' and coalesce(updated_at_ms, updated_at * 1000) >= ?'
            params.append(cutoff)
    rows = []
    for (tid, rollout, updated, created, source, originator, provider, cwd, title, first_msg,
         archived) in con.execute(sql, params):
        runtime = codex_runtime(source, originator, provider)
        try:
            tail = codex_tail(rollout)
        except Exception as e:
            rows.append(unreadable_row('codex', tid, rollout, e, name=codex_request(title), cwd=cwd, runtime=runtime))
            continue
        if archived:
            status = 'archived'
        elif tail['running'] and now_ms() - os.path.getmtime(rollout) * 1000 < CODEX_STALE_MS:
            status = 'running'
        else:
            status = 'your-turn'
        rows.append({
            'key': f'codex:{tid}', 'id': tid, 'status': status, 'detail': '', 'since': updated,
            'live': status == 'running', 'runtime': runtime,
            'name': codex_request(title), 'brief': codex_request(first_msg), 'step': tail['step'],
            'last_active': updated, 'created': created, 'cwd': cwd, 'focused': 0, 'reply': tail['reply'],
            'last_prompt': tail['last_prompt'], 'provider': provider, 'pid': None, 'desktop_id': None,
            'path': rollout, 'error': None,
        })
    con.close()
    return rows


# ---------------------------------------------------------------- output

def collect(since_ms, include_all=False, id_prefix=None):
    """since_ms=None means no activity window."""
    cutoff = None if since_ms is None else now_ms() - since_ms
    rows = load_claude(cutoff, include_all, id_prefix) + load_codex(cutoff, include_all, id_prefix)
    if not id_prefix and not include_all:
        rows = [r for r in rows if r['status'] in ('waiting', 'running', 'your-turn')
                and (r['live'] or cutoff is None or r['last_active'] >= cutoff)]
    elif not id_prefix and cutoff is not None:
        rows = [r for r in rows if r['last_active'] >= cutoff]
    return sorted(rows, key=lambda r: (STATUS_ORDER[r['status']], -r['last_active']))


def char_width(c):
    if unicodedata.category(c) in ('Mn', 'Me', 'Cf'):
        return 0
    return 2 if unicodedata.east_asian_width(c) in 'WF' else 1


def fit(text, width):
    text = one_line(text)
    out, used = [], 0
    for c in text:
        w = char_width(c)
        if used + w > width:
            while out and used + 1 > width:  # make room for the ellipsis
                used -= char_width(out.pop())
            out.append('…')
            used += 1
            break
        out.append(c)
        used += w
    return ''.join(out) + ' ' * (width - used)


def ago(ms):
    s = max(0, (now_ms() - ms) // 1000)
    for unit, n in (('d', 86400), ('h', 3600), ('m', 60)):
        if s >= n:
            return f'{s // n}{unit}'
    return f'{s}s'


def paint(text, status):
    if not sys.stdout.isatty() or os.environ.get('NO_COLOR'):
        return text
    return f'\033[{STATUS_COLOR[status]}m{text}\033[0m'


def short_cwd(cwd):
    return '~' + cwd[len(HOME):] if cwd.startswith(HOME) else cwd


def render_table(rows):
    if not rows:
        print('no sessions match')
        return
    cols = shutil.get_terminal_size((200, 40)).columns
    rt_w = max(len('RUNTIME'), *(len(r['runtime']) for r in rows))
    proj_w = min(18, max(len('PROJECT'), *(len(os.path.basename(r['cwd'])) for r in rows)))
    fixed = 8 + 9 + rt_w + 6 + proj_w + 7 * 2  # id, status, runtime, active, project + gaps
    flex = max(30, cols - fixed)
    name_w, brief_w = flex * 3 // 10, flex * 35 // 100
    step_w = flex - name_w - brief_w
    widths = [8, 9, rt_w, name_w, brief_w, step_w, 6, proj_w]
    header = ['ID', 'STATUS', 'RUNTIME', 'NAME', 'BRIEF', 'LATEST STEP', 'ACTIVE', 'PROJECT']
    print('  '.join(fit(h, w) for h, w in zip(header, widths)).rstrip())
    for r in rows:
        cells = [r['id'][:8], r['status'], r['runtime'], r['name'], r['brief'], r['step'],
                 ago(r['last_active']), os.path.basename(r['cwd'])]
        out = [fit(c, w) for c, w in zip(cells, widths)]
        out[1] = paint(out[1], r['status'])
        print('  '.join(out).rstrip())
    counts = {}
    for r in rows:
        counts[r['status']] = counts.get(r['status'], 0) + 1
    print('\n' + ' · '.join(f'{n} {s}' for s, n in sorted(counts.items(), key=lambda kv: STATUS_ORDER[kv[0]])))


def resume_cmd(r):
    """Shell command that reopens the session in a terminal; works for every runtime."""
    cd = f'cd {shlex.quote(r["cwd"])} && '
    if r['runtime'].startswith('codex'):
        provider = f' -c model_provider={r["provider"]}' if r['provider'] != codex_default_provider() else ''
        return f'{cd}codex resume{provider} {r["id"]}'
    return f'{cd}claude --resume {r["id"]}'


def resume_hint(r):
    rt = r['runtime']
    if rt == 'vscode':
        return f'code {shlex.quote(r["cwd"])}  → Claude panel → "{r["name"]}"'
    if rt == 'claude-code':
        return f'Claude app → Code → "{r["name"]}"'
    if rt.startswith('codex-app'):
        return f'Codex app → "{r["name"]}"  or  {resume_cmd(r)}'
    return resume_cmd(r)


def print_block(r, reply_lines):
    head = f'[{r["status"]} {ago(r["since"] if r["status"] == "waiting" else r["last_active"])}]'
    print(f'{paint(head, r["status"])} {r["name"]}  ({r["runtime"]}, {short_cwd(r["cwd"])})  id {r["id"][:8]}')
    if r['detail']:
        print(f'  needs you: {one_line(r["detail"])}')
    lines = r['reply'].splitlines() or ['(no reply text)']
    for line in lines[:reply_lines] if reply_lines else lines:
        print(f'  │ {line}')
    if reply_lines and len(lines) > reply_lines:
        print(f'  │ … {len(lines) - reply_lines} more lines: aitop show {r["id"][:8]}')
    print(f'  resume: {resume_hint(r)}\n')


# ---------------------------------------------------------------- seen state

def load_seen():
    if not os.path.exists(SEEN_PATH):
        return {}
    with open(SEEN_PATH) as f:
        return json.load(f)


def save_seen(seen):
    os.makedirs(os.path.dirname(SEEN_PATH), exist_ok=True)
    tmp = SEEN_PATH + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(seen, f, indent=1)
    os.replace(tmp, SEEN_PATH)


def ack_rows(rows):
    seen = load_seen()
    for r in rows:
        seen[r['key']] = r['last_active']
    save_seen(seen)


class NotFound(Exception):
    pass


def resolve(prefix):
    rows = collect(None, include_all=True, id_prefix=prefix)
    if not rows:
        raise NotFound(f'no session id starts with {prefix!r}')
    if len(rows) > 1:
        ids = ', '.join(f'{r["id"]} ({r["name"]})' for r in rows)
        raise NotFound(f'{prefix!r} is ambiguous: {ids}')
    return rows[0]


def split_catchup(rows, since_ms):
    """Sessions blocked on a decision, and your-turn sessions with a reply you have not acked."""
    seen = load_seen()
    cutoff = now_ms() - since_ms
    waiting = sorted((r for r in rows if r['status'] == 'waiting'), key=lambda r: r['since'])
    fresh = [r for r in rows if r['status'] == 'your-turn' and r['reply'] and r['last_active'] >= cutoff
             and r['last_active'] > max(seen.get(r['key'], 0), r['focused'])]
    return waiting, fresh


def week_start_ms():
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    return int((today - timedelta(days=today.weekday())).timestamp() * 1000)


def week_rows():
    """(Monday 00:00, sessions created since then, older sessions active again since then)."""
    start = week_start_ms()
    rows = collect(now_ms() - start, include_all=True)
    return start, [r for r in rows if r['created'] >= start], [r for r in rows if r['created'] < start]


# ---------------------------------------------------------------- commands

def cmd_list(args):
    since = args.since if args.since is not None or args.all else parse_since('7d')
    rows = collect(since, include_all=args.all)
    if args.runtime:
        rows = [r for r in rows if r['runtime'].startswith(args.runtime)]
    render_table(rows)


def cmd_catchup(args):
    waiting, fresh = split_catchup(collect(args.since), args.since)
    for r in waiting + fresh:
        print_block(r, 12)
    if not waiting and not fresh:
        print('nothing is waiting on you')
        return
    print(f'{len(waiting)} waiting on a decision · {len(fresh)} new replies · '
          f'aitop show <id> for the full reply · aitop ack --all to clear')


def cmd_show(args):
    r = resolve(args.id)
    if r['last_prompt']:
        print('you asked:')
        for line in r['last_prompt'].splitlines():
            print(f'  > {line}')
        print()
    print_block(r, 0)
    ack_rows([r])


def cmd_ack(args):
    if args.all == bool(args.ids):
        sys.exit('aitop ack: give either session id prefixes or --all')
    rows = collect(args.since) if args.all else [resolve(p) for p in args.ids]
    ack_rows(rows)
    print(f'acked {len(rows)} session(s)')


def cmd_week(args):
    start, new, resumed = week_rows()
    print(f'== New this week (since {datetime.fromtimestamp(start / 1000):%a %m-%d}): {len(new)}\n')
    render_table(new)
    print(f'\n== Created earlier, active again this week: {len(resumed)}\n')
    render_table(resumed)


# ---------------------------------------------------------------- jump to a session

GHOSTTY_APP = '/Applications/Ghostty.app'


def applescript_str(s):
    return '"' + s.replace('\\', '\\\\').replace('"', '\\"') + '"'


def terminal_steps(r):
    """Open a new terminal window that resumes the session, keeping a shell when the agent exits."""
    cmd = resume_cmd(r)
    if sys.platform != 'darwin':
        raise RuntimeError(f'Opening a terminal is only automated on macOS. Run it yourself:\n{cmd}')
    if os.path.isdir(GHOSTTY_APP):
        return 'Ghostty', [['osascript', '-e', '\n'.join([
            'tell application "Ghostty"', 'activate', 'set cfg to new surface configuration',
            f'set initial working directory of cfg to {applescript_str(r["cwd"])}',
            f'set initial input of cfg to {applescript_str(cmd)} & linefeed',
            'new window with configuration cfg', 'end tell'])]]
    return 'Terminal', [['osascript', '-e', f'tell application "Terminal"\nactivate\ndo script {applescript_str(cmd)}\nend tell']]


def host_app(pid):
    """The .app bundle whose process tree contains pid, e.g. the terminal a CLI session runs in."""
    while pid > 1:
        out = subprocess.run(['ps', '-o', 'ppid=,comm=', '-p', str(pid)], capture_output=True, text=True).stdout.strip()
        if not out:
            return None
        ppid, comm = out.split(None, 1)
        if '.app/' in comm:
            return comm[:comm.index('.app/') + len('.app')]
        pid = int(ppid)
    return None


def open_steps(r, target):
    """(app label, commands) that bring a session to the front; None in the list means pause."""
    if target == 'terminal':
        return terminal_steps(r)
    rt = r['runtime'].split('/')[0]
    if rt == 'vscode':
        # The extension opens the session in the focused window, so focus the session's folder first.
        focus = ['open', '-a', 'Visual Studio Code', r['cwd']] if sys.platform == 'darwin' else ['code', r['cwd']]
        return 'VSCode', [focus, None, [OPENER, f'vscode://anthropic.claude-code/open?session={r["id"]}']]
    if rt == 'claude-code' and r['desktop_id']:
        return 'Claude', [[OPENER, f'claude://code/continue?session={r["desktop_id"]}']]
    if rt == 'claude-cli' and r['pid'] and sys.platform == 'darwin':
        app = host_app(r['pid'])
        if app:
            return os.path.basename(app)[:-len('.app')], [['open', '-a', app]]
    if rt in ('codex-app', 'codex-chrome', 'codex'):
        return 'Codex', [[OPENER, f'codex://threads/{r["id"]}']]
    return terminal_steps(r)


def run_steps(steps):
    for step in steps:
        if step is None:
            time.sleep(1.2)  # let the window take focus before the next command targets it
            continue
        p = subprocess.run(step, capture_output=True, text=True, timeout=15)
        if p.returncode:
            raise RuntimeError(f'{step[0]} exited {p.returncode}: {p.stderr.strip()}')


# ---------------------------------------------------------------- usage index (insights)

USAGE_CACHE = os.path.join(CACHE_DIR, 'usage-v2.json')
INDEX_LOCK = threading.Lock()
EDIT_TOOLS = ('Edit', 'Write', 'MultiEdit', 'NotebookEdit')
# Patch headers inside apply_patch input; the path stops at a newline, an escaped newline or a quote.
PATCH_FILE = re.compile(r'\*\*\* (?:Add|Update|Delete) File: ([^\n\\"]+)')
RANGES = {'7d': 7, '30d': 30, '90d': 90, 'all': None}
RUNTIME_ORDER = ['vscode', 'claude-code', 'codex-app', 'claude-cli', 'codex-cli', 'codex-chrome', 'codex',
                 'claude-archive', 'other']


def day_of(ts):
    return time.strftime('%Y-%m-%d', time.localtime(ts))


def usage_paths():
    claude = (glob.glob(os.path.join(CLAUDE_DIR, 'projects', '*', '*.jsonl'))
              + glob.glob(os.path.join(CLAUDE_DIR, 'projects', '*', '*', 'subagents', '*.jsonl')))
    codex = (glob.glob(os.path.join(CODEX_DIR, 'sessions', '*', '*', '*', '*.jsonl'))
             + glob.glob(os.path.join(CODEX_DIR, 'archived_sessions', '*.jsonl')))
    return [('claude', p) for p in claude] + [('codex', p) for p in codex]


def new_entry(kind, path, head):
    e = {'kind': kind, 'head': head, 'offset': 0, 'first': None, 'cwd': '', 'runtime': None,
         'prompts': [], 'tools': {}, 'edits': {}}
    if kind == 'claude':
        sub = os.path.basename(os.path.dirname(path)) == 'subagents'
        sid = os.path.basename(os.path.dirname(os.path.dirname(path))) if sub else os.path.basename(path)[:-6]
        e.update(session=sid, is_session=not sub, msgs={}, prs=[])
    else:
        e.update(session=None, is_session=False, model='', prev=[0, 0], tok={})  # filled from session_meta
    return e


def index_claude_line(e, line):
    if e['runtime'] is None and b'"entrypoint"' in line:
        rec = json.loads(line)
        e['runtime'] = CLAUDE_RUNTIME.get(rec['entrypoint'], 'other')
        e['cwd'] = rec.get('cwd') or ''
    if b'"type":"assistant"' in line:
        rec = json.loads(line)
        if rec.get('type') != 'assistant':
            return
        ts = iso_ms(rec['timestamp']) // 1000
        e['first'] = e['first'] or ts
        msg = rec['message']
        usage = msg.get('usage')
        # Claude Code writes one record per content block, each repeating the message's usage.
        if usage and msg.get('id') and msg['id'] not in e['msgs'] and msg.get('model') != '<synthetic>':
            e['msgs'][msg['id']] = [ts, msg.get('model') or '?',
                                    usage.get('input_tokens', 0) + usage.get('cache_creation_input_tokens', 0),
                                    usage.get('cache_read_input_tokens', 0), usage.get('output_tokens', 0)]
        for block in msg.get('content') or []:
            if block.get('type') == 'tool_use':
                day = day_of(ts)
                e['tools'][day] = e['tools'].get(day, 0) + 1
                path = (block.get('input') or {}).get('file_path')
                if block['name'] in EDIT_TOOLS and path:
                    e['edits'].setdefault(path, ts)
    elif b'"type":"user"' in line and b'"tool_use_id"' not in line:
        rec = json.loads(line)
        if rec.get('type') == 'user' and claude_prompt(rec):
            ts = iso_ms(rec['timestamp']) // 1000
            e['first'] = e['first'] or ts
            e['prompts'].append(ts)
    elif b'"type":"pr-link"' in line:
        rec = json.loads(line)
        if rec.get('type') == 'pr-link':
            e['prs'].append([iso_ms(rec['timestamp']) // 1000, rec['prUrl'], rec.get('prRepository', ''),
                             rec.get('prNumber')])


def index_codex_line(e, line):
    if b'"session_meta"' in line:
        rec = json.loads(line)
        if rec.get('type') == 'session_meta' and e['session'] is None:
            p = rec['payload']
            source = p.get('source')
            e['session'] = p['id']
            e['is_session'] = isinstance(source, str) and p.get('thread_source') != 'guardian_review'
            e['runtime'] = codex_runtime(source if isinstance(source, str) else '', p.get('originator') or '',
                                         p.get('model_provider') or '')
            e['cwd'] = p.get('cwd') or ''
            e['first'] = iso_ms(p['timestamp']) // 1000
        return
    if b'"turn_context"' in line:
        rec = json.loads(line)
        if rec.get('type') == 'turn_context':
            e['model'] = rec['payload'].get('model') or e['model']
        return
    if b'"token_count"' in line:
        rec = json.loads(line)
        info = (rec.get('payload') or {}).get('info')
        if rec.get('type') != 'event_msg' or not info or not info.get('total_token_usage'):
            return
        t = info['total_token_usage']
        cur = [t.get('input_tokens', 0), t.get('output_tokens', 0)]
        if cur == e['prev']:
            return  # re-emitted without a new request
        e['prev'] = cur
        # Sum per-request usage: the cumulative counter can restart mid-thread, so deltas of it overcount.
        last = info.get('last_token_usage') or {}
        cached = last.get('cached_input_tokens', 0)
        key = f'{day_of(iso_ms(rec["timestamp"]) // 1000)}|{e["model"] or "?"}'
        acc = e['tok'].setdefault(key, [0, 0, 0])
        acc[0] += last.get('input_tokens', 0) - cached  # Codex input includes cached tokens
        acc[1] += cached
        acc[2] += last.get('output_tokens', 0)
        return
    if b'"task_started"' in line:
        rec = json.loads(line)
        if rec.get('type') == 'event_msg' and rec['payload'].get('type') == 'task_started':
            e['prompts'].append(iso_ms(rec['timestamp']) // 1000)
        return
    if b'"type":"function_call"' in line or b'"type":"custom_tool_call"' in line:
        rec = json.loads(line)
        p = rec.get('payload') or {}
        if rec.get('type') == 'response_item' and p.get('type') in ('function_call', 'custom_tool_call'):
            ts = iso_ms(rec['timestamp']) // 1000
            e['tools'][day_of(ts)] = e['tools'].get(day_of(ts), 0) + 1
            for path in PATCH_FILE.findall(p.get('input') or p.get('arguments') or ''):
                e['edits'].setdefault(path.strip(), ts)


def load_usage():
    """Index every transcript and rollout, reading only bytes appended since the last run.

    Entries for files that have since been deleted stay in the cache, so cleanup does not erase history.
    """
    cache = {'files': {}}
    if os.path.exists(USAGE_CACHE):
        with open(USAGE_CACHE) as f:
            cache = json.load(f)
    files = cache['files']
    changed = False
    for kind, path in usage_paths():
        try:
            size = os.path.getsize(path)
            e = files.get(path)
            if e and e['offset'] == size:
                continue
            with open(path, 'rb') as f:
                head = f.read(64).hex()
                if not e or e['head'] != head or size < e['offset']:
                    e = files[path] = new_entry(kind, path, head)
                f.seek(e['offset'])
                for line in f:
                    if not line.endswith(b'\n'):
                        break  # the agent is still writing this record
                    e['offset'] += len(line)
                    try:
                        (index_claude_line if kind == 'claude' else index_codex_line)(e, line)
                    except Exception as err:
                        # A damaged record costs that record, not the whole index; Insights reports the count.
                        e['bad'] = e.get('bad', 0) + 1
                        e.setdefault('bad_msg', describe(err))
        except FileNotFoundError:
            continue  # deleted between glob and read
        except OSError as err:
            warn(f'skipped {path}: {describe(err)}')
            continue
        changed = True
    if changed:
        os.makedirs(os.path.dirname(USAGE_CACHE), exist_ok=True)
        tmp = USAGE_CACHE + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(cache, f, separators=(',', ':'))
        os.replace(tmp, USAGE_CACHE)
    return files


def claude_archive_days():
    """Per-day session counts from Claude Code's own stats cache, which predates the kept transcripts."""
    path = os.path.join(CLAUDE_DIR, 'stats-cache.json')
    if not os.path.exists(path):
        return {}
    try:
        with open(path) as f:
            return {a['date']: a['sessionCount'] for a in json.load(f).get('dailyActivity', [])}
    except (ValueError, KeyError, TypeError) as e:
        warn(f'skipped {path}: {describe(e)}')
        return {}


def stats(range_key):
    if range_key not in RANGES:
        raise argparse.ArgumentTypeError(f'range must be one of {", ".join(RANGES)}; got {range_key!r}')
    with INDEX_LOCK:
        files = load_usage()
    today = datetime.now().date()
    as_date = lambda ts: datetime.fromtimestamp(ts).date()

    # Codex can hold the same thread twice (live and archived copies); keep the fuller one.
    codex = {}
    for e in files.values():
        if e['kind'] == 'codex' and e['session'] and (e['session'] not in codex or e['offset'] > codex[e['session']]['offset']):
            codex[e['session']] = e
    entries = [e for e in files.values() if e['kind'] == 'claude'] + list(codex.values())
    parent = {e['session']: e for e in entries if e['kind'] == 'claude' and e['is_session']}
    claude_first = min((as_date(e['first']) for e in parent.values() if e['first']), default=today)
    archive = {datetime.strptime(d, '%Y-%m-%d').date(): n for d, n in claude_archive_days().items()
               if datetime.strptime(d, '%Y-%m-%d').date() < claude_first}

    days = RANGES[range_key]
    if days:
        start = today - timedelta(days=days - 1)
        prev_start = start - timedelta(days=days)
    else:
        firsts = [as_date(e['first']) for e in entries if e['first']] + list(archive)
        start, prev_start = min(firsts, default=today), None
    weekly = (today - start).days >= 92
    bucket_of = (lambda d: d - timedelta(days=d.weekday())) if weekly else (lambda d: d)
    buckets, d = [], bucket_of(start)
    while d <= today:
        buckets.append(d)
        d += timedelta(days=7 if weekly else 1)
    index = {b: i for i, b in enumerate(buckets)}

    def period(d):
        if start <= d <= today:
            return 0
        if prev_start and prev_start <= d < start:
            return 1
        return None

    kpi = {k: [0, 0] for k in ('sessions', 'prompts', 'tokens', 'fresh', 'tools', 'edits', 'prs')}
    sessions, tokens = {}, {}
    prompts = [0] * len(buckets)
    heat = [[0] * 24 for _ in range(7)]
    models, projects, prs = {}, {}, {}
    edits = [set(), set()]  # files touched per period, across sessions

    def project(e):
        cwd = e['cwd'] or parent.get(e['session'], {}).get('cwd', '')
        return projects.setdefault(cwd or '(unknown)', {'name': os.path.basename(cwd) or '(unknown)', 'cwd': cwd,
                                                        'sessions': 0, 'prompts': 0, 'tokens': 0, 'fresh': 0})

    def add_tokens(e, rt, d, model, fresh_in, cached, out):
        p = period(d)
        if p is None:
            return
        kpi['tokens'][p] += fresh_in + cached + out
        kpi['fresh'][p] += fresh_in + out
        if p == 0:
            series = tokens.setdefault(rt, [[0, 0, 0] for _ in buckets])[index[bucket_of(d)]]
            series[0] += fresh_in
            series[1] += cached
            series[2] += out
            m = models.setdefault(model, [0, 0, 0])
            m[0] += fresh_in
            m[1] += cached
            m[2] += out
            proj = project(e)
            proj['tokens'] += fresh_in + cached + out
            proj['fresh'] += fresh_in + out

    seen_msgs = set()
    for e in entries:
        rt = (e['runtime'] or parent.get(e['session'], {}).get('runtime') or 'other').split('/')[0]
        rt = rt if rt in RUNTIME_ORDER else 'other'
        if e['is_session'] and e['first']:
            d = as_date(e['first'])
            p = period(d)
            if p is not None:
                kpi['sessions'][p] += 1
            if p == 0:
                sessions.setdefault(rt, [0] * len(buckets))[index[bucket_of(d)]] += 1
                project(e)['sessions'] += 1
        if e['is_session']:
            for ts in e['prompts']:
                d = as_date(ts)
                p = period(d)
                if p is not None:
                    kpi['prompts'][p] += 1
                if p == 0:
                    prompts[index[bucket_of(d)]] += 1
                    lt = time.localtime(ts)
                    heat[lt.tm_wday][lt.tm_hour] += 1
                    project(e)['prompts'] += 1
        for day, n in e['tools'].items():
            p = period(datetime.strptime(day, '%Y-%m-%d').date())
            if p is not None:
                kpi['tools'][p] += n
        for path, ts in e['edits'].items():
            p = period(as_date(ts))
            if p is not None:
                edits[p].add(path)
        for ts, url, repo, number in e.get('prs', []):
            if url not in prs or ts < prs[url][0]:
                prs[url] = [ts, url, repo, number]
        if e['kind'] == 'claude':
            for mid, (ts, model, fresh_in, cached, out) in e['msgs'].items():
                if mid not in seen_msgs:
                    seen_msgs.add(mid)  # forked and resumed transcripts copy earlier messages
                    add_tokens(e, rt, as_date(ts), model, fresh_in, cached, out)
        else:
            for key, (fresh_in, cached, out) in e['tok'].items():
                day, model = key.split('|', 1)
                add_tokens(e, rt, datetime.strptime(day, '%Y-%m-%d').date(), model, fresh_in, cached, out)

    for d, n in archive.items():
        p = period(d)
        if p is not None:
            kpi['sessions'][p] += n
        if p == 0:
            sessions.setdefault('claude-archive', [0] * len(buckets))[index[bucket_of(d)]] += n
    kpi['edits'] = [len(edits[0]), len(edits[1])]
    pr_list = sorted((v for v in prs.values() if period(as_date(v[0])) is not None), reverse=True)
    for ts, *_ in pr_list:
        kpi['prs'][period(as_date(ts))] += 1

    present = [rt for rt in RUNTIME_ORDER if rt in sessions or rt in tokens]
    return {
        'range': range_key, 'bucket': 'week' if weekly else 'day', 'has_prev': prev_start is not None,
        'buckets': [b.isoformat() for b in buckets], 'runtimes': present,
        'sessions': sessions, 'tokens': tokens, 'prompts': prompts, 'kpi': kpi, 'heat': heat,
        'models': sorted(([m, *v] for m, v in models.items()), key=lambda m: -(m[1] + m[3]))[:8],
        'projects': sorted((p for p in projects.values() if p['tokens'] or p['sessions']),
                           key=lambda p: -p['fresh'])[:8],
        'prs': [{'ts': ts, 'url': url, 'repo': repo, 'number': number}
                for ts, url, repo, number in pr_list if period(as_date(ts)) == 0][:12],
        'archive_until': claude_first.isoformat() if archive else None,
        'indexed': {'files': len(files), 'bytes': sum(e['offset'] for e in files.values()),
                    'unreadable_records': sum(e.get('bad', 0) for e in files.values())},
    }


