.prompt { margin: 0; padding: 2px 0 2px 14px; border-left: 2px solid var(--line-strong); color: var(--ink-2); white-space: pre-wrap; overflow-wrap: anywhere;
  max-height: 14em; overflow-y: auto; }
.reply { padding: 14px 16px; border-radius: 10px; background: var(--raised); border: 1px solid var(--line); white-space: pre-wrap; overflow-wrap: anywhere;
