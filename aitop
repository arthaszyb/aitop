def to_json(r, full=False):
    out = {k: r[k] for k in ('id', 'status', 'detail', 'since', 'live', 'runtime', 'name', 'last_active', 'created',
                             'cwd', 'error')}
    out.update(brief=r['brief'][:400], step=r['step'][:300], where=short_cwd(r['cwd']))
    if full:
        out.update(reply=r['reply'], last_prompt=r['last_prompt'], resume=resume_hint(r), resume_cmd=resume_cmd(r))
    return out


def api_get(path, q):
    if path == '/api/catchup':
        since = parse_since(q.get('since', '7d'))
        rows = collect(since)
        waiting, fresh = split_catchup(rows, since)
        runtimes = {}
        for r in rows:
            runtimes.setdefault(r['runtime'].split('/')[0], {'waiting': 0, 'running': 0, 'your-turn': 0})[r['status']] += 1
        return {'counts': {s: sum(r['status'] == s for r in rows) for s in STATUS_ORDER},
                'runtimes': runtimes, 'terminal': 'Ghostty' if os.path.isdir(GHOSTTY_APP) else 'Terminal',
                'waiting': [to_json(r, full=True) for r in waiting],
                'fresh': [to_json(r, full=True) for r in fresh]}
    if path == '/api/stats':
        return stats(q.get('range', '30d'))
    if path == '/api/week':
        start, new, resumed = week_rows()
        return {'start': start, 'new': [to_json(r) for r in new], 'resumed': [to_json(r) for r in resumed]}
    if path == '/api/list':
        since = parse_since(q['since']) if q.get('since') else None
        return {'rows': [to_json(r) for r in collect(since, include_all=q.get('all') == '1')]}
    if path == '/api/session':
        return to_json(resolve(q['id']), full=True)
    if path == '/api/brief':
        return brief_state(q.get('kind', 'weekly'), parse_day(q['date']) if q.get('date') else date.today())
    raise NotFound(f'no route {path}')


def api_post(path, body):
    if path == '/api/open':
        app, steps = open_steps(resolve(body['id']), body.get('target', 'app'))
        run_steps(steps)
        return {'app': app}
    if path == '/api/brief':
        return start_brief_job(body['kind'], parse_day(body['date']))
    if path != '/api/ack':
        raise NotFound(f'no route {path}')
    rows = collect(parse_since('7d')) if body.get('all') else [resolve(i) for i in body['ids']]
    ack_rows(rows)
    return {'acked': len(rows)}


class PortalHandler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass  # the page polls every 20s; access logs would bury the tracebacks printed below

    def send(self, code, body, ctype='application/json; charset=utf-8'):
        data = body if isinstance(body, bytes) else json.dumps(body, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        self.dispatch()

    def do_POST(self):
        self.dispatch()

    def dispatch(self):
        # Answer only requests addressed to this loopback port, so a DNS-rebinding page cannot read sessions.
        if self.headers.get('Host') not in self.server.allowed_hosts:
            return self.send(403, {'error': 'unexpected Host header'})
        url = urlparse(self.path)
        if self.command == 'GET' and url.path == '/':
            return self.send(200, PORTAL_HTML.encode(), 'text/html; charset=utf-8')
        try:
            if self.command == 'GET':
                body = api_get(url.path, {k: v[0] for k, v in parse_qs(url.query).items()})
            elif self.headers.get('Content-Type', '').split(';')[0] != 'application/json':
                # A JSON body forces a CORS preflight on cross-site POSTs, and this server never approves one.
                return self.send(415, {'error': 'expected application/json'})
            else:
                body = api_post(url.path, json.loads(self.rfile.read(int(self.headers['Content-Length']))))
        except NotFound as e:
            return self.send(404, {'error': str(e)})
        except argparse.ArgumentTypeError as e:
            return self.send(400, {'error': str(e)})
        except Exception:
            traceback.print_exc()
            return self.send(500, {'error': traceback.format_exc()})
        self.send(200, body)


def cmd_serve(args):
    server = ThreadingHTTPServer(('127.0.0.1', args.port), PortalHandler)
    server.allowed_hosts = {f'127.0.0.1:{args.port}', f'localhost:{args.port}'}
    print(f'aitop portal: http://127.0.0.1:{args.port}/  (Ctrl-C to stop)', flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print()


