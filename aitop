    'risks': ['<blocker, risk or dependency that could slip>'],
    'priorities': [{'name': '<one of the categories>', 'projects': [{'name': '<project>', 'tasks': [{
        'title': '<task>', 'progress': 'done', 'summary': '<what was done>', 'outputs': ['<link or deliverable>'],
        'todos': ['<open follow-up>'], 'sessions': ['1a2b3c4d']}]}]}],
    'skipped': ['<8-char ids of personal sessions left out>'],
}, indent=1)
BRIEF_PARTS = ('overview', 'next_steps', 'highlights', 'risks', 'priorities')
BRIEF_PROMPT = """You are writing a {kind} work briefing for one person, covering {label} ({start} to {last}).
Below is a digest of every AI agent session that person worked in during the period: what they asked and what the agent reported back.

Write every text field in {language}. The briefing has three parts and is read top to bottom by someone with little time.

1. overview: 3 to 5 points that together say what the period was about. Each point names one main area of work in a few words ("focus") and says in one short sentence of at most 25 words where it stands now ("status"), with the key number, result or decision. Order the points by importance. This is a summary, not a task list: fold related tasks into one point and leave minor work out.

2. Short lists, each item one line of at most 20 words:
- next_steps: the 3 to 6 most important concrete actions to take next.
- highlights: up to 4 results worth calling out.
- risks: up to 4 blockers, risks or dependencies that could slip. Use an empty list if there are none.

3. priorities: the full work record. Order categories, projects and tasks by importance, most significant first, and group the work this way:
- category: exactly one of: {categories}.
- project: the real project, system or initiative the work served. Infer it from what the turns are about. The working directory is only a hint, since one directory often holds many unrelated projects.
- task: one concrete piece of work. Merge sessions and turns that worked on the same task into one task.

For each task give:
- progress: one of "done", "in progress", "blocked", "not started".
- summary: one or two sentences on what was done, keeping specific numbers, names and ids from the digest.
- outputs: concrete results such as links, tickets, merge requests, documents, files or decisions. Copy URLs exactly.
- todos: follow-ups the digest shows are still open.
- sessions: the 8-character ids of the sessions that contributed.

Leave out sessions that are clearly personal and unrelated to work, and list their ids in "skipped".
Use only facts present in the digest. Never invent progress, links, risks or todos. Use an empty list when a field has nothing.

Reply with JSON only, with no prose and no code fence, in this shape:
{schema}

Digest:

{digest}
"""


def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH) as f:
            for section, values in json.load(f).items():
                cfg.setdefault(section, {}).update(values)
    return cfg


def parse_day(value):
    try:
        return date.fromisoformat(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f'expected a date like 2026-10-30; got {value!r}')


def brief_period(kind, day):
    """(first day, day after the last, label) of the period that contains day."""
    if kind not in BRIEF_KINDS:
        raise argparse.ArgumentTypeError(f'kind must be one of {", ".join(BRIEF_KINDS)}; got {kind!r}')
    if kind == 'daily':
        return day, day + timedelta(days=1), day.strftime('%A, %b %-d, %Y')
    if kind == 'weekly':
        start = day - timedelta(days=day.weekday())
        return start, start + timedelta(days=7), f'Week of {start:%b %-d, %Y}'
    start = day.replace(day=1)
    return start, (start + timedelta(days=32)).replace(day=1), start.strftime('%B %Y')


def local_ts(d):
    return time.mktime(d.timetuple())


def clip(text, n):
    text = re.sub(r'\n{3,}', '\n\n', text.strip())
    return text if len(text) <= n else text[:n].rstrip() + ' …'


def claude_turns(path, t0, t1):
    """[ts, prompt, final reply] for each human prompt sent in [t0, t1)."""
    turns = []
    with open(path, 'rb') as f:
        for line in f:
            if not line.endswith(b'\n'):
                break  # the agent is still writing this record
            if b'"type":"user"' in line and b'"tool_use_id"' not in line:
                rec = json.loads(line)
                prompt = claude_prompt(rec) if rec.get('type') == 'user' else ''
                if prompt:
                    turns.append([iso_ms(rec['timestamp']) // 1000, prompt, ''])
            elif turns and b'"type":"assistant"' in line:
                rec = json.loads(line)
                if rec.get('type') == 'assistant' and not rec.get('isSidechain'):
                    text = claude_text(rec['message'].get('content') or []).strip()
                    if text:
                        turns[-1][2] = text
    return [t for t in turns if t0 <= t[0] < t1]


def codex_turns(path, t0, t1):
    turns = []
    with open(path, 'rb') as f:
        for line in f:
            if not line.endswith(b'\n'):
                break
            if b'"role":"user"' in line:
                rec = json.loads(line)
                p = rec.get('payload') or {}
                if rec.get('type') == 'response_item' and p.get('type') == 'message' and p.get('role') == 'user':
                    text = '\n'.join(c.get('text', '') for c in p.get('content') or [] if 'text' in c).strip()
                    # Codex injects context (environment, instructions) as user messages wrapped in tags.
                    if text and not text.startswith('<') and not text.startswith('# AGENTS.md'):
                        turns.append([iso_ms(rec['timestamp']) // 1000, codex_request(text), ''])
            elif turns and b'"task_complete"' in line:
                rec = json.loads(line)
                p = rec.get('payload') or {}
                if rec.get('type') == 'event_msg' and p.get('type') == 'task_complete' and p.get('last_agent_message'):
                    turns[-1][2] = p['last_agent_message']
    return [t for t in turns if t0 <= t[0] < t1]


def active_entries(t0, t1):
    """{session id: (path, index entry)} for sessions with a prompt in [t0, t1) whose file still exists."""
    with INDEX_LOCK:
        files = load_usage()
    picked = {}
    for path, e in files.items():
        if not (e['is_session'] and e['session'] and any(t0 <= ts < t1 for ts in e['prompts'])):
            continue
        if os.path.exists(path) and (e['session'] not in picked or e['offset'] > picked[e['session']][1]['offset']):
            picked[e['session']] = (path, e)
    return picked


def brief_sessions(start, end):
    """(sessions with turns in the period, names of sessions that could not be read)."""
    t0, t1 = local_ts(start), local_ts(end)
    rows = {r['id']: r for r in collect(None, include_all=True)}
    sessions, unreadable = [], []
    for sid, (path, e) in active_entries(t0, t1).items():
        r = rows.get(sid, {})
        try:
            turns = (claude_turns if e['kind'] == 'claude' else codex_turns)(path, t0, t1)
        except Exception as err:
            warn(f'left session {sid} out of the briefing: {describe(err)}')
            unreadable.append(r.get('name') or sid[:8])
            continue
        if not turns:
            continue
        sessions.append({
            'id': sid, 'name': r.get('name') or sid[:8], 'runtime': r.get('runtime') or e['runtime'] or e['kind'],
            'status': r.get('status', 'closed'), 'cwd': e['cwd'] or r.get('cwd', ''), 'opened_with': r.get('brief', ''),
            'turns': turns, 'edits': sorted(p for p, ts in e['edits'].items() if t0 <= ts < t1),
            'prs': sorted({url for ts, url, *_ in e.get('prs', []) if t0 <= ts < t1}),
        })
    return sorted(sessions, key=lambda s: s['turns'][0][0]), unreadable


def brief_digest(sessions, budget):
    per_session = max(1500, budget // max(1, len(sessions)))
    parts = []
    for s in sessions:
        head = [f'### Session {s["id"][:8]}: {s["name"]}',
                f'Runtime: {s["runtime"]}. Working directory: {s["cwd"] or "unknown"}. Status now: {s["status"]}.']
        if s['opened_with']:
            head.append(f'Session opened with: {clip(s["opened_with"], 300)}')
        if s['prs']:
            head.append('PRs/MRs linked: ' + ', '.join(s['prs']))
        if s['edits']:
            head.append(f'Files edited ({len(s["edits"])}): ' + ', '.join(os.path.basename(p) for p in s['edits'][:12]))
        turns = [f'- [{time.strftime("%m-%d %H:%M", time.localtime(ts))}] Asked: {clip(prompt, 500)}\n'
                 f'  Result: {clip(reply, 900) if reply else "(no reply yet)"}' for ts, prompt, reply in s['turns']]
        # Keep the first turn for context, then as many of the latest turns as the budget allows.
        kept, latest, used = turns[:1], [], sum(map(len, head)) + len(turns[0])
        for t in reversed(turns[1:]):
            if used + len(t) > per_session:
                break
            latest.insert(0, t)
            used += len(t)
        omitted = len(turns) - 1 - len(latest)
        parts.append('\n'.join(head + kept + ([f'- ({omitted} turns in between left out)'] if omitted else []) + latest))
    return '\n\n'.join(parts)


def run_brief_llm(prompt, cfg):
    workdir = os.path.join(CACHE_DIR, 'brief-runs')  # a fixed folder keeps runs out of real project folders
    os.makedirs(workdir, exist_ok=True)
    p = subprocess.run(cfg['command'], input=prompt, capture_output=True, text=True, timeout=cfg['timeout'], cwd=workdir)
    if p.returncode:
        raise RuntimeError(f'{cfg["command"][0]} exited {p.returncode}: {p.stderr.strip()[-2000:]}')
    start = p.stdout.find('{')  # the CLI may print notices or a code fence around the JSON
    if start < 0:
        raise ValueError(f'The LLM reply contained no JSON object:\n{p.stdout.strip()[:2000]}')
    try:
        return json.JSONDecoder().raw_decode(p.stdout, start)[0]
    except json.JSONDecodeError as e:
        raise ValueError(f'The LLM reply was not valid JSON ({e}):\n{p.stdout[start:start + 2000]}') from e


def merge_groups(report):
    """Fold categories and projects the model repeated under the same name into one."""
    missing = [k for k in BRIEF_PARTS if k not in report]
    if missing:
        raise ValueError(f'The LLM reply is missing {", ".join(missing)}: {json.dumps(report)[:1000]}')
    cats = {}
    for cat in report['priorities']:
        cats.setdefault(cat['name'].strip().lower(), {'name': cat['name'], 'projects': []})['projects'] += cat.get('projects', [])
    for cat in cats.values():
        projects = {}
        for proj in cat['projects']:
            projects.setdefault(proj['name'].strip().lower(), {'name': proj['name'], 'tasks': []})['tasks'] += proj.get('tasks', [])
        cat['projects'] = list(projects.values())
    report['priorities'] = list(cats.values())
    return report


def brief_path(kind, start):
    return os.path.join(BRIEF_DIR, f'{kind}-{start.isoformat()}.json')


def generate_brief(kind, day):
    cfg = load_config()['brief']
    start, end, label = brief_period(kind, day)
    sessions, unreadable = brief_sessions(start, end)
    if not sessions:
        raise NotFound(f'No session had a prompt in {label}.')
    digest = brief_digest(sessions, cfg['digest_chars'])
    prompt = BRIEF_PROMPT.format(kind=kind, label=label, start=start, last=end - timedelta(days=1),
                                 language=cfg['language'], categories=', '.join(cfg['categories']),
                                 schema=BRIEF_SCHEMA, digest=digest)
    report = merge_groups(run_brief_llm(prompt, cfg))
    brief = {
        'kind': kind, 'start': start.isoformat(), 'end': end.isoformat(), 'label': label,
        'generated_at': int(time.time()), 'command': cfg['command'][0], 'digest_chars': len(digest),
        'sessions': {s['id'][:8]: {'id': s['id'], 'name': s['name'], 'runtime': s['runtime']} for s in sessions},
        'stats': {'sessions': len(sessions), 'prompts': sum(len(s['turns']) for s in sessions),
                  'edits': len({p for s in sessions for p in s['edits']}), 'prs': len({u for s in sessions for u in s['prs']})},
        'report': report, 'unreadable': unreadable,
    }
    os.makedirs(BRIEF_DIR, exist_ok=True)
    tmp = brief_path(kind, start) + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(brief, f, ensure_ascii=False, indent=1)
    os.replace(tmp, brief_path(kind, start))
    return brief


def brief_markdown(brief):
    r, s = brief['report'], brief['stats']
    lines = [f'# {brief["label"]}', '', '## Overview', '']
    lines += [f'- **{p["focus"]}**: {p["status"]}' for p in r['overview']]
    lines += ['', f'{s["sessions"]} sessions, {s["prompts"]} prompts, {s["edits"]} files edited, {s["prs"]} PRs/MRs linked.',
              '', '## Next steps']
    for title, key in (('Up next', 'next_steps'), ('Highlights', 'highlights'), ('Risks', 'risks')):
        if r[key]:
            lines += ['', f'### {title}', ''] + [f'- {x}' for x in r[key]]
    lines += ['', '## Priorities']
    for cat in r['priorities']:
        lines += ['', f'### {cat["name"]}']
        for proj in cat['projects']:
            lines += ['', f'#### {proj["name"]}', '']
            for t in proj['tasks']:
                lines.append(f'- **{t["title"]}** ({t.get("progress", "")}): {t.get("summary", "")}')
                if t.get('outputs'):
                    lines.append('  - Outputs: ' + '; '.join(t['outputs']))
                if t.get('todos'):
                    lines.append('  - To do: ' + '; '.join(t['todos']))
    if brief.get('unreadable'):
        lines += ['', f'Left out because they could not be read: {", ".join(brief["unreadable"])}.']
    return '\n'.join(lines).strip() + '\n'


def load_brief(kind, start):
    path = brief_path(kind, start)
    if not os.path.exists(path):
        return None
    with open(path) as f:
        brief = json.load(f)
    merge_groups(brief['report'])
    return brief


def brief_state(kind, day):
    start, end, label = brief_period(kind, day)
    brief = load_brief(kind, start)
    return {'kind': kind, 'start': start.isoformat(), 'end': end.isoformat(), 'label': label,
            'today': date.today().isoformat(), 'active': len(active_entries(local_ts(start), local_ts(end))),
            'brief': brief, 'markdown': brief_markdown(brief) if brief else None,
            'job': BRIEF_JOBS.get(f'{kind}-{start}')}


def start_brief_job(kind, day):
    start, _, _ = brief_period(kind, day)
    key = f'{kind}-{start}'
    with BRIEF_LOCK:
        if BRIEF_JOBS.get(key, {}).get('state') == 'running':
            return BRIEF_JOBS[key]
        job = BRIEF_JOBS[key] = {'state': 'running', 'started': int(time.time()), 'error': None}

    def work():
        try:
            generate_brief(kind, day)
            job['state'] = 'done'
        except Exception as e:
            traceback.print_exc()
            job.update(state='failed', error=f'{type(e).__name__}: {e}')

    threading.Thread(target=work, daemon=True).start()
    return job


def cmd_brief(args):
    start, _, label = brief_period(args.kind, args.date)
    brief = None if args.regenerate else load_brief(args.kind, start)
    if brief is None:
        print(f'Writing the {args.kind} briefing for {label} with {load_config()["brief"]["command"][0]}; '
              'this can take a few minutes.', file=sys.stderr, flush=True)
        brief = generate_brief(args.kind, args.date)
    print(brief_markdown(brief), end='')


